generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid())
  supabaseId         String              @unique
  email              String              @unique
  name               String?
  plan               String              @default("trial")
  trialEndsAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  adAccounts         AdAccount[]
  reports            Report[]
  facebookConnection FacebookConnection?
  businessManagers   BusinessManager[]
  instagramAccounts  InstagramAccount[]
}

model FacebookConnection {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fbUserId       String
  fbUserName     String
  fbUserEmail    String?
  accessToken    String
  tokenExpiresAt DateTime
  tokenInvalid   Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AdAccount {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  metaAccountId    String
  metaAccessToken  String
  accountName      String
  currency         String    @default("BRL")
  timezone         String    @default("America/Sao_Paulo")
  accountStatus    Int?
  isActive         Boolean   @default(true)
  source           String    @default("manual")
  connectedAt      DateTime  @default(now())
  lastSyncAt       DateTime?

  @@unique([userId, metaAccountId])
}

model CachedInsights {
  id          String   @id @default(uuid())
  adAccountId String
  level       String
  entityId    String
  dateFrom    String
  dateTo      String
  data        Json
  cachedAt    DateTime @default(now())

  @@unique([adAccountId, level, entityId, dateFrom, dateTo])
}

model TokenRenewalFailure {
  id         String   @id @default(uuid())
  userId     String
  fbUserName String
  error      String
  attempts   Int      @default(3)
  failedAt   DateTime @default(now())

  @@index([userId])
  @@index([failedAt])
}

model Report {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccountId String
  name        String
  dateFrom    String
  dateTo      String
  type        String
  fileUrl     String?
  status      String   @default("pending")
  errorMsg    String?
  createdAt   DateTime @default(now())
}

model BusinessManager {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bmId        String
  bmName      String
  syncedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, bmId])
}

model InstagramAccount {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  igAccountId      String
  username         String
  name             String?
  profilePicUrl    String?
  followersCount   Int?
  mediaCount       Int?
  linkedPageId     String
  linkedPageName   String?
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, igAccountId])
}
