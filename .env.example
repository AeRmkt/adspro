# Raiz do monorepo — copie para apps/api/.env e apps/web/.env

# ── API ──────────────────────────────────────────────────
DATABASE_URL=postgresql://adspro:adspro_secret@localhost:5432/adspro_dev
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
APP_SECRET=sua-chave-de-32-caracteres-aqui!!
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ── Meta OAuth (login do Facebook → puxa BMs e contas) ───
# Reaproveitar o MESMO App Meta do 7otoni-stories-bot.
# App ID (público): 1230523169225608
META_APP_ID=1230523169225608
META_APP_SECRET=o-mesmo-secret-do-stories-bot
# URL pública do callback (a rota /api/auth/meta/callback da API).
# Local: http://localhost:3001/api/auth/meta/callback
# Prod:  https://SEU-API.up.railway.app/api/auth/meta/callback
# ESTA URL precisa estar cadastrada em "Valid OAuth Redirect URIs" no app Meta.
META_CALLBACK_URL=http://localhost:3001/api/auth/meta/callback

# ── WEB ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
